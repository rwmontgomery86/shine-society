# Urable CRM — used by app/api/lead/route.ts (server-side only).
# Do NOT prefix with NEXT_PUBLIC_ — that would expose the token to the browser.
URABLE_ACCESS_TOKEN=replace-me
URABLE_API_BASE_URL=https://app.urable.com/api

# Optional — base URL used for OG metadata in app/layout.tsx.
# Defaults to http://localhost:3000 when unset.
# NEXT_PUBLIC_SITE_URL=https://shine-society.vercel.app
